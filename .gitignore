# OpenFarm - Ignore patterns

# ── Environment / Secrets ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
*.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Node / Next.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.turbo/

# ── Docker ───────────────────────────────────────────────────────────
docker/data/

# ── IDE / OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
*.code-workspace

# ── Internal Docs ────────────────────────────────────────────────────
# R&D docs stay local; the design system reference and TaskList are tracked
docs/*
!docs/design/
!docs/TaskList.md

# ── Logs / Temp ──────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# ── MinIO / Storage (local dev volumes) ──────────────────────────────
minio-data/
.agents/

# ── TypeScript build cache ──────────────────────────────────────────
*.tsbuildinfo

# ── Terraform (deploy/terraform) ────────────────────────────────────
# .terraform.lock.hcl IS committed (pins provider hashes)
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/terraform.tfvars
deploy/terraform/crash.log
deploy/terraform/crash.*.log
deploy/terraform/tfplan
deploy/terraform/*.tfplan
