# OpenFarm — Ignore patterns

# ── Environment / Secrets ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
*.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ── Node / Next.js ───────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.turbo/

# ── Docker ───────────────────────────────────────────────────────────
docker/data/

# ── IDE / OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
*.code-workspace

# ── Internal Docs ────────────────────────────────────────────────────
docs/

# ── Logs / Temp ──────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# ── MinIO / Storage (local dev volumes) ──────────────────────────────
minio-data/
.agents/
